# Build outputs
target/
**/target/
dist/
node_modules/

# Tauri v2 generated capability/permission schemas
src-tauri/gen/

# Tooling
.playwright-mcp/

# Android platform-tools fetched at build time (issue #125). The directory is
# kept so the Tauri bundler always finds its resource source.
src-tauri/resources/platform-tools/*
!src-tauri/resources/platform-tools/.gitkeep

# Env / local config
.env
.env.*
*.local

# Logs
*.log

# OS cruft
.DS_Store
Thumbs.db

# Editor
.idea/
.vscode/
runtime/
