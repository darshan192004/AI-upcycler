{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node", "vitest/globals"],
    "paths": {
      "@ai-upcycler/protocol": ["./packages/protocol/src/index.ts"],
      "@ai-upcycler/engine-client": ["./packages/engine-client/src/index.ts"],
      "@ai-upcycler/layer-planner": ["./packages/layer-planner/src/index.ts"],
      "@ai-upcycler/cloud-images": ["./packages/cloud-images/src/index.ts"],
      "@ai-upcycler/native-engine": ["./packages/native-engine/src/index.ts"],
      "@ai-upcycler/ui": ["./packages/ui/src/index.ts"]
    }
  },
  "include": [
    "apps/*/App.tsx",
    "apps/*/src/**/*.ts",
    "apps/*/src/**/*.tsx",
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.tsx",
    "vitest.config.ts"
  ],
  "exclude": ["**/node_modules/**", "**/android/**", "**/windows/**", "dist"]
}
