<?xml version="1.0" encoding="utf-8"?>
<!--
  Sub-project B's opt-in, bearer-authenticated LAN API speaks plain HTTP to a
  master on the local network, so the base config permits cleartext. This does
  NOT relax pairing: EnrollmentClient still refuses plain HTTP to every
  non-loopback host, so enrollment responses (fresh private keys and the LAN
  token) are never sent in cleartext. The ADB reverse tunnel target remains
  named explicitly below. The manifest deliberately has no
  android:usesCleartextTraffic shortcut.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
    <domain-config cleartextTrafficPermitted="true">
        <!-- ADB reverse tunnel target: the worker's own loopback. -->
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
